# Data source: "local" for JSON files, "strapi" for Strapi API (default when unset)
DATA_SOURCE=local

# Required when DATA_SOURCE=strapi. Also used by export-strapi script.
NEXT_PUBLIC_BASE_URL=https://your-strapi-instance.com

# Email (contact form — required for /api/send-email)
# GoDaddy-style: HOST=smtpout.secureserver.net, PORT=465, EMAIL_TLS=true
# Or port 587 with EMAIL_TLS=false (STARTTLS)
EMAIL_HOST=
EMAIL_PORT=587
# SMTP login + From address
EMAIL_USER=
EMAIL_PASS=
# Inbox that receives contact form submissions (can differ from EMAIL_USER)
EMAIL_TO=info@anamrinarecruitment.com
EMAIL_TLS=false
# Set to false to skip SMTP verify() before each send (not recommended)
# EMAIL_SMTP_VERIFY=false
# Optional: GET /api/send-email — health check for uptime monitors (verifies SMTP login)

# Contact form anti-spam (optional — defaults shown)
# CONTACT_FORM_MIN_MS=3000
# CONTACT_FORM_MAX_MS=3600000
# CONTACT_FORM_RATE_LIMIT_MAX=5
# CONTACT_FORM_RATE_LIMIT_WINDOW_MS=900000
