        "__component": "layout.info-card-block",
        "id": {},
        "Title": "Why Irish Businesses Choose Anamrina?",
        "Description": "Irish businesses are under pressure to grow while keeping costs down. Anamrina helps you do both — by giving you instant access to qualified, remote professionals at a fraction of local hiring costs. We manage the recruitment, equipment, and day-to-day oversight so you can focus on results, not admin.",
        "cards": [
          {
            "id": {},
            "Title": "60% Lower Costs",
            "Description": "Reduce staffing expenses without sacrificing quality.",
            "iconName": "FiTrendingDown"
          },
          {
            "id": {},
            "Title": "We Manage Everything",
            "Description": "From hiring to HR to hardware, we handle it all.",
            "iconName": "MdManageAccounts"
          },
          {
            "id": {},
            "Title": "Fully Qualified Talent",
            "Description": "Degree-holding professionals, fluent in English.",
            "iconName": "FaUserGraduate"
          },
          {
            "id": {},
            "Title": "Custom-Built Teams",
            "Description": "Scale as needed — no office, no long-term contracts.",
            "iconName": "HiOutlineUsers"
          }
        ]
      },
